---
import { siteConfig } from '../config/site';
import { Menu, X, Command } from 'lucide-astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const normalizePath = (path: string) => {
  if (path === '/') return '/';
  return path.endsWith('/') ? path : `${path}/`;
};

const activeNormalized = normalizePath(currentPath);
---

<header class="sticky top-0 z-40 w-full border-b border-white/10 bg-[#06080e]/85 backdrop-blur-md transition-all duration-300">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-3 transition-transform duration-200 active:scale-95 shrink-0" aria-label="Trang chủ">
      <div class="relative flex h-9 w-9 items-center justify-center rounded-lg border border-cyan-500/40 bg-gradient-to-br from-cyan-950/60 to-slate-900 shadow-neon-sm group-hover:border-cyan-400">
        <span class="font-mono text-base font-bold text-cyan-400 group-hover:text-cyan-300">N</span>
        <span class="absolute -right-0.5 -top-0.5 flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan-500"></span>
        </span>
      </div>
      <div class="flex flex-col">
        <span class="font-mono text-sm font-bold tracking-wider text-slate-100 group-hover:text-cyan-300">
          {siteConfig.siteName} <span class="text-cyan-400">//</span>
        </span>
        <span class="text-[10px] font-mono tracking-widest uppercase text-slate-400">
          PORTFOLIO
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-0.5 lg:gap-1 rounded-full border border-white/10 bg-slate-950/60 p-1 lg:p-1.5 backdrop-blur-md">
      {siteConfig.navLinks.map((item) => {
        const itemNormalized = normalizePath(item.href);
        const isActive = itemNormalized === '/' 
          ? activeNormalized === '/' 
          : activeNormalized.startsWith(itemNormalized);

        return (
          <a
            href={item.href}
            class:list={[
              'relative whitespace-nowrap shrink-0 px-2.5 py-1.5 lg:px-3.5 lg:py-1.5 text-xs font-medium transition-all duration-200 rounded-full inline-flex items-center gap-1.5 border leading-none',
              isActive
                ? 'text-cyan-300 bg-cyan-950/70 border-cyan-500/30 shadow-sm'
                : 'text-slate-300 border-transparent hover:text-white hover:bg-white/5'
            ]}
          >
            <span class="whitespace-nowrap">{item.title}</span>
            {item.badge && (
              <span class="inline-flex items-center shrink-0 rounded px-1.5 py-0.5 text-[9px] font-mono font-medium leading-none tracking-wide text-cyan-300 bg-cyan-500/20 border border-cyan-500/30 uppercase">
                {item.badge}
              </span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Right Controls: Command Palette & Mobile Menu Toggle -->
    <div class="flex items-center gap-2 shrink-0">
      <!-- Command Palette Button -->
      <button
        type="button"
        id="cmd-palette-btn"
        class="hidden sm:flex items-center gap-2 rounded-lg border border-white/10 bg-slate-900/60 px-2.5 py-1.5 text-xs text-slate-400 transition-colors hover:border-cyan-500/40 hover:text-slate-200 shrink-0"
        aria-label="Mở Command Palette (Ctrl+K)"
      >
        <Command class="h-3.5 w-3.5 text-cyan-400 shrink-0" />
        <span class="hidden xl:inline font-mono text-[11px]">Quick Jump</span>
        <kbd class="rounded border border-white/15 bg-white/5 px-1.5 py-0.5 font-mono text-[10px] text-slate-300 shrink-0">
          ⌘K
        </kbd>
      </button>

      <!-- GitHub Link -->
      <a
        href={siteConfig.author.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:flex items-center gap-1.5 rounded-lg border border-white/10 bg-slate-900/60 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-cyan-500/40 hover:text-cyan-300 shrink-0"
        aria-label="GitHub Repository"
      >
        <span class="font-mono text-[11px]">GitHub</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-slate-900/60 text-slate-300 transition-colors hover:border-cyan-500/40 hover:text-white md:hidden"
        aria-label="Mở menu điều hướng"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span id="menu-icon-open">
          <Menu class="h-5 w-5" />
        </span>
        <span id="menu-icon-close" class="hidden">
          <X class="h-5 w-5" />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-menu"
    class="hidden border-b border-white/10 bg-[#06080e]/95 px-4 pt-2 pb-6 backdrop-blur-xl md:hidden"
  >
    <div class="flex flex-col space-y-1">
      {siteConfig.navLinks.map((item) => {
        const itemNormalized = normalizePath(item.href);
        const isActive = itemNormalized === '/' 
          ? activeNormalized === '/' 
          : activeNormalized.startsWith(itemNormalized);

        return (
          <a
            href={item.href}
            class:list={[
              'flex items-center justify-between rounded-lg px-3 py-2.5 text-sm font-medium transition-colors border',
              isActive
                ? 'bg-cyan-950/60 text-cyan-300 border-cyan-500/30'
                : 'text-slate-300 border-transparent hover:bg-white/5 hover:text-white'
            ]}
          >
            <span>{item.title}</span>
            {item.badge && (
              <span class="inline-flex items-center shrink-0 rounded bg-cyan-500/20 px-1.5 py-0.5 font-mono text-[10px] font-medium leading-none text-cyan-300 border border-cyan-500/30 uppercase tracking-wide">
                {item.badge}
              </span>
            )}
          </a>
        );
      })}
    </div>

    <div class="mt-4 pt-4 border-t border-white/10 flex items-center justify-between">
      <button
        type="button"
        id="mobile-cmd-btn"
        class="flex items-center gap-2 rounded-lg border border-white/10 bg-slate-900/80 px-3 py-2 text-xs text-slate-300"
      >
        <Command class="h-4 w-4 text-cyan-400" />
        <span class="font-mono">Command Palette (Ctrl+K)</span>
      </button>
      <a
        href={siteConfig.author.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-white/10 bg-slate-900/80 px-3 py-2 text-xs font-mono text-cyan-400"
      >
        GitHub
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && menu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }

  // Handle Command Palette triggers from Header buttons
  const triggerCmd = () => {
    window.dispatchEvent(new CustomEvent('open-command-palette'));
  };

  document.getElementById('cmd-palette-btn')?.addEventListener('click', triggerCmd);
  document.getElementById('mobile-cmd-btn')?.addEventListener('click', () => {
    menu?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    triggerCmd();
  });
</script>
