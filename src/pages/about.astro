---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { getEntry, render } from 'astro:content';
import {
  User,
  GraduationCap,
  Terminal,
  Cpu,
  Layers,
  Code2,
  Database,
  Wrench,
  Bot,
  Github,
  Mail,
  Linkedin,
} from 'lucide-astro';

const aboutEntry = await getEntry('pages', 'about');
if (!aboutEntry) {
  throw new Error('Could not find src/content/pages/about.md');
}

const { Content } = await render(aboutEntry);

const categoryIcons: Record<string, any> = {
  Languages: Code2,
  Frontend: Layers,
  Backend: Terminal,
  Database: Database,
  'Tools & DevOps': Wrench,
  'AI & Playground': Bot,
};

const levelColors: Record<string, string> = {
  Advanced: 'border-cyan-500/30 text-cyan-300 bg-cyan-950/40',
  Core: 'border-sky-500/30 text-sky-300 bg-sky-950/40',
  Exploring: 'border-violet-500/30 text-violet-300 bg-violet-950/40',
};
---

<BaseLayout
  title="Về Bản Thân // About"
  description="Câu chuyện học tập, định hướng công nghệ và kỹ năng chuyên môn."
  currentPath="/about/"
>
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Header Hero -->
    <header class="mb-14 border-b border-white/10 pb-10">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-950/40 px-3 py-1 font-mono text-xs text-cyan-400 mb-4">
            <User class="h-3.5 w-3.5" />
            <span>KỸ SƯ PHẦN MỀM // HỒ SƠ</span>
          </div>

          <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
            {aboutEntry.data.title}
          </h1>

          <p class="mt-3 text-lg text-slate-300 max-w-2xl font-light">
            {aboutEntry.data.description}
          </p>
        </div>

        <!-- Avatar & Social Card -->
        <div class="flex flex-col items-center rounded-2xl border border-white/10 bg-slate-900/50 p-6 backdrop-blur-md shrink-0 w-full md:w-64 text-center">
          <div class="relative mb-4">
            <img
              src={siteConfig.author.avatarUrl}
              alt={siteConfig.author.name}
              class="h-24 w-24 rounded-full border-2 border-cyan-400/50 object-cover shadow-neon-sm"
              width="96"
              height="96"
            />
            <span class="absolute bottom-0 right-0 h-4 w-4 rounded-full border-2 border-[#090d18] bg-emerald-400" title="Online"></span>
          </div>

          <h2 class="text-base font-bold text-white">{siteConfig.author.name}</h2>
          <p class="text-xs text-cyan-400 font-mono mt-0.5">{siteConfig.author.role}</p>
          <p class="text-[11px] text-slate-400 mt-1">{siteConfig.author.location}</p>

          <div class="mt-4 flex items-center gap-2 border-t border-white/10 pt-4 w-full justify-center">
            <a
              href={siteConfig.author.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-white/10 bg-slate-800 p-2 text-slate-300 hover:text-cyan-300"
              aria-label="GitHub Profile"
            >
              <Github class="h-4 w-4" />
            </a>
            <a
              href={siteConfig.author.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-white/10 bg-slate-800 p-2 text-slate-300 hover:text-cyan-300"
              aria-label="LinkedIn Profile"
            >
              <Linkedin class="h-4 w-4" />
            </a>
            <a
              href={`mailto:${siteConfig.author.email}`}
              class="rounded-lg border border-white/10 bg-slate-800 p-2 text-slate-300 hover:text-cyan-300"
              aria-label="Send Email"
            >
              <Mail class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Markdown Content from src/content/pages/about.md -->
    <section class="glass-panel rounded-3xl p-8 sm:p-10 mb-16">
      <div class="prose-content">
        <Content />
      </div>
    </section>

    <!-- Categorized Skills Section -->
    <section class="mb-20">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 text-xs font-mono text-cyan-400 mb-1">
          <Cpu class="h-4 w-4" />
          <span>TECHNICAL COMPETENCIES</span>
        </div>
        <h2 class="text-3xl font-extrabold text-white tracking-tight">
          Kỹ Năng Theo Nhóm Chuyên Môn
        </h2>
        <p class="text-sm text-slate-400 mt-1">
          Được phân chia theo 6 danh mục trọng tâm từ nền tảng ngôn ngữ tới công cụ AI.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {siteConfig.skills.map((cat) => {
          const Icon = categoryIcons[cat.name] || Terminal;
          return (
            <div class="glass-card rounded-2xl p-6">
              <div class="flex items-center gap-3 mb-2">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-cyan-500/30 bg-cyan-950/40 text-cyan-400">
                  <Icon class="h-5 w-5" />
                </div>
                <div>
                  <h3 class="text-base font-bold text-white">{cat.name}</h3>
                  <p class="text-[11px] text-slate-400">{cat.description}</p>
                </div>
              </div>

              <div class="mt-4 flex flex-wrap gap-2">
                {cat.items.map((skill) => {
                  const levelClass = levelColors[skill.level] || 'border-slate-500/30 text-slate-300';
                  return (
                    <div class="flex items-center gap-1.5 rounded-lg border border-white/10 bg-slate-900/80 px-2.5 py-1 text-xs">
                      <span class="font-medium text-slate-200">{skill.name}</span>
                      <span class:list={['rounded px-1.5 py-0.2 font-mono text-[9px] border', levelClass]}>
                        {skill.level}
                      </span>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Milestones Timeline Section -->
    <section class="mb-16">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 text-xs font-mono text-violet-400 mb-1">
          <GraduationCap class="h-4 w-4" />
          <span>CAREER & ACADEMIC TIMELINE</span>
        </div>
        <h2 class="text-3xl font-extrabold text-white tracking-tight">
          Cột Mốc & Hành Trình Phát Triển
        </h2>
      </div>

      <div class="relative border-l border-cyan-500/30 ml-4 pl-6 space-y-10">
        {siteConfig.milestones.map((m) => (
          <div class="relative group">
            <!-- Node dot -->
            <div class="absolute -left-[31px] top-1.5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-cyan-400 bg-[#06080e]">
              <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 group-hover:scale-125 transition-transform"></span>
            </div>

            <div class="glass-card rounded-2xl p-6">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="font-mono text-xs font-semibold text-cyan-400">
                  {m.year}
                </span>
                {m.badge && (
                  <span class="rounded-md border border-violet-500/30 bg-violet-950/40 px-2 py-0.5 font-mono text-[10px] text-violet-300">
                    {m.badge}
                  </span>
                )}
              </div>

              <h3 class="text-lg font-bold text-white">{m.title}</h3>
              <p class="text-xs text-slate-400 font-mono mt-0.5">{m.organization}</p>
              <p class="mt-3 text-xs leading-relaxed text-slate-300">{m.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
