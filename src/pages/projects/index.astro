---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { FolderGit2 } from 'lucide-astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort(
  (a, b) => (a.data.order || 99) - (b.data.order || 99)
);

const categories = ['All', 'Web', 'AI & Tools'];
---

<BaseLayout
  title="Dự Án // Projects"
  description="Bộ sưu tập các dự án phần mềm, ứng dụng web hiệu năng cao và thử nghiệm AI."
  currentPath="/projects/"
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Header -->
    <header class="mb-12 border-b border-white/10 pb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-950/40 px-3 py-1 font-mono text-xs text-cyan-400 mb-4">
        <FolderGit2 class="h-3.5 w-3.5" />
        <span>ENGINEERING SHOWCASE</span>
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Dự Án & Sản Phẩm Thực Nghiệm
      </h1>
      <p class="mt-3 text-base text-slate-300 max-w-2xl font-light">
        Các giải pháp phần mềm được xây dựng với mục tiêu tối ưu hiệu năng, kiến trúc rõ ràng và khả năng tương tác trực quan.
      </p>

      <!-- Category Filter Tabs -->
      <div class="mt-8 flex flex-wrap items-center gap-2" id="project-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class:list={[
              'project-filter-btn rounded-xl px-4 py-2 text-xs font-mono transition-all',
              idx === 0
                ? 'active bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 shadow-neon-sm'
                : 'bg-slate-900/60 text-slate-400 border border-white/10 hover:text-slate-200'
            ]}
            data-category={cat}
          >
            {cat === 'All' ? `Tất cả (${sortedProjects.length})` : cat}
          </button>
        ))}
      </div>
    </header>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedProjects.map((project) => (
        <div
          class="project-card-wrapper"
          data-category={project.data.category}
        >
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            tagline={project.data.tagline}
            category={project.data.category}
            status={project.data.status}
            techStack={project.data.techStack}
            demoUrl={project.data.demoUrl}
            githubUrl={project.data.githubUrl}
            slug={project.id}
            featured={project.data.featured}
          />
        </div>
      ))}
    </div>

    <!-- Note on placeholders -->
    <div class="mt-16 rounded-2xl border border-white/10 bg-slate-950/50 p-6 text-center text-xs text-slate-400 font-mono">
      <p>
        💡 Thông tin dự án được quản lý tập trung trong thư mục <code class="text-cyan-400">src/content/projects/</code>. Bạn có thể dễ dàng thêm hoặc chỉnh sửa chi tiết dự án bằng Markdown.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.project-filter-btn');
  const projectCards = document.querySelectorAll('.project-card-wrapper');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');

      filterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'shadow-neon-sm');
        b.classList.add('bg-slate-900/60', 'text-slate-400', 'border-white/10');
      });

      btn.classList.remove('bg-slate-900/60', 'text-slate-400', 'border-white/10');
      btn.classList.add('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'shadow-neon-sm');

      projectCards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (cat === 'All' || cardCat === cat) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
