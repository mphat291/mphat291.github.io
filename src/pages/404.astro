---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Terminal, Home, ArrowLeft } from 'lucide-astro';
---

<BaseLayout
  title="404 // Không Tìm Thấy Trang"
  description="Trang bạn đang tìm kiếm không tồn tại hoặc đã được di chuyển sang địa chỉ mới."
  currentPath="/404"
>
  <div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-md w-full text-center">
      <!-- 404 Glitch Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-red-500/30 bg-red-950/40 px-3.5 py-1 font-mono text-xs text-red-400 mb-6">
        <Terminal class="h-3.5 w-3.5" />
        <span>ERROR_CODE: 404 // NULL_POINTER</span>
      </div>

      <h1 class="text-7xl sm:text-8xl font-black font-mono tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-violet-500">
        404
      </h1>

      <h2 class="mt-4 text-xl font-bold text-white tracking-tight">
        Tọa độ không tồn tại trong hệ thống
      </h2>

      <p class="mt-3 text-xs sm:text-sm text-slate-400 leading-relaxed">
        Đường dẫn bạn vừa truy cập có thể đã được đổi tên, chuyển dời cấu trúc hoặc chưa từng được khai báo trong hệ thống router tĩnh.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-500 px-6 py-2.5 text-xs font-semibold text-slate-950 shadow-neon-cyan hover:brightness-110 transition-all"
        >
          <Home class="h-4 w-4" />
          <span>Quay về Trang Chủ</span>
        </a>

        <a
          href="/projects/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-slate-900/80 px-6 py-2.5 text-xs font-medium text-slate-200 hover:border-cyan-400 hover:text-cyan-300"
        >
          <ArrowLeft class="h-4 w-4" />
          <span>Xem Danh Mục Dự Án</span>
        </a>
      </div>

      <div class="mt-10 pt-6 border-t border-white/5 font-mono text-[11px] text-slate-500">
        Mẹo: Nhấn <kbd class="rounded border border-white/15 bg-white/5 px-1 py-0.5 text-slate-300">Ctrl+K</kbd> để tìm kiếm trang bất kỳ
      </div>
    </div>
  </div>
</BaseLayout>
