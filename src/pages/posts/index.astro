---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { BookOpen, Search } from 'lucide-astro';

// Get all posts, filtering out drafts in production
const allPosts = await getCollection('posts');
const publishedPosts = allPosts
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Extract unique tags
const allTags = Array.from(new Set(publishedPosts.flatMap((p) => p.data.tags)));
---

<BaseLayout
  title="Bài Viết & Ghi Chú // Posts"
  description="Chia sẻ kiến thức kỹ thuật, ghi chép học tập và kinh nghiệm xây dựng ứng dụng web hiện đại."
  currentPath="/posts/"
>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Header -->
    <header class="mb-12 border-b border-white/10 pb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-violet-500/30 bg-violet-950/40 px-3 py-1 font-mono text-xs text-violet-400 mb-4">
        <BookOpen class="h-3.5 w-3.5" />
        <span>KNOWLEDGE REPOSITORY</span>
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Bài Viết & Ghi Chú Kỹ Thuật
      </h1>
      <p class="mt-3 text-base text-slate-300 max-w-2xl font-light">
        Nơi ghi lại các thử nghiệm kiến trúc, tối ưu hiệu năng web, và các giải pháp thực chiến trong quá trình học tập.
      </p>

      <!-- Search & Filters Container -->
      <div class="mt-8 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <!-- Search input -->
        <div class="relative flex-1 max-w-md">
          <Search class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
          <input
            id="post-search-input"
            type="text"
            placeholder="Tìm theo tiêu đề, mô tả hoặc từ khóa..."
            class="w-full rounded-xl border border-white/10 bg-slate-900/80 pl-10 pr-4 py-2.5 text-xs text-slate-100 placeholder-slate-400 focus:border-cyan-400 focus:outline-none"
          />
        </div>

        <!-- Tag filter pills -->
        <div class="flex flex-wrap items-center gap-1.5" id="tag-filter-container">
          <button
            type="button"
            class="tag-pill active rounded-lg border border-cyan-500/40 bg-cyan-950/60 px-3 py-1.5 font-mono text-xs text-cyan-300"
            data-tag="all"
          >
            Tất cả ({publishedPosts.length})
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              class="tag-pill rounded-lg border border-white/10 bg-slate-900/60 px-3 py-1.5 font-mono text-xs text-slate-400 hover:text-slate-200"
              data-tag={tag.toLowerCase()}
            >
              #{tag}
            </button>
          ))}
        </div>
      </div>
    </header>

    <!-- Post list grid -->
    <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {publishedPosts.map((post) => (
        <div
          class="post-wrapper"
          data-title={post.data.title.toLowerCase()}
          data-desc={post.data.description.toLowerCase()}
          data-tags={post.data.tags.map((t) => t.toLowerCase()).join(' ')}
          data-category={post.data.category.toLowerCase()}
        >
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            category={post.data.category}
            slug={post.id}
          />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-16">
      <p class="font-mono text-sm text-slate-400">
        Không tìm thấy bài viết nào phù hợp với từ khóa đã chọn.
      </p>
      <button
        type="button"
        id="reset-filter-btn"
        class="mt-4 rounded-lg border border-white/10 bg-slate-800 px-4 py-2 text-xs font-mono text-cyan-400 hover:border-cyan-400"
      >
        Đặt lại bộ lọc
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('post-search-input') as HTMLInputElement | null;
  const tagPills = document.querySelectorAll('.tag-pill');
  const postWrappers = Array.from(document.querySelectorAll('.post-wrapper')) as HTMLElement[];
  const emptyState = document.getElementById('empty-state');
  const resetBtn = document.getElementById('reset-filter-btn');

  let currentTag = 'all';
  let searchQuery = '';

  function filterPosts() {
    let visibleCount = 0;

    postWrappers.forEach((wrapper) => {
      const title = wrapper.getAttribute('data-title') || '';
      const desc = wrapper.getAttribute('data-desc') || '';
      const tags = wrapper.getAttribute('data-tags') || '';
      const category = wrapper.getAttribute('data-category') || '';

      const matchesSearch =
        !searchQuery ||
        title.includes(searchQuery) ||
        desc.includes(searchQuery) ||
        tags.includes(searchQuery) ||
        category.includes(searchQuery);

      const matchesTag =
        currentTag === 'all' || tags.includes(currentTag);

      if (matchesSearch && matchesTag) {
        wrapper.style.display = 'block';
        visibleCount++;
      } else {
        wrapper.style.display = 'none';
      }
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount > 0);
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterPosts();
  });

  tagPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      tagPills.forEach((p) => {
        p.classList.remove('active', 'border-cyan-500/40', 'bg-cyan-950/60', 'text-cyan-300');
        p.classList.add('border-white/10', 'bg-slate-900/60', 'text-slate-400');
      });

      pill.classList.remove('border-white/10', 'bg-slate-900/60', 'text-slate-400');
      pill.classList.add('active', 'border-cyan-500/40', 'bg-cyan-950/60', 'text-cyan-300');

      currentTag = pill.getAttribute('data-tag') || 'all';
      filterPosts();
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    currentTag = 'all';
    tagPills.forEach((p) => {
      if (p.getAttribute('data-tag') === 'all') {
        p.classList.add('active', 'border-cyan-500/40', 'bg-cyan-950/60', 'text-cyan-300');
      } else {
        p.classList.remove('active', 'border-cyan-500/40', 'bg-cyan-950/60', 'text-cyan-300');
      }
    });
    filterPosts();
  });
</script>
